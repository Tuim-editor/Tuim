[0.2, "o", "\u001b[2J\u001b[H\n                         TUIM\n\n              Terminal-native editor and IDE\n\n              Ctrl+N   New file\n              Ctrl+F   Find files\n              Ctrl+E   Toggle explorer\n              Ctrl+T   Toggle terminal\n              F11      Zen / previous mode\n\n              Plugins are offline for this session.\n~\n~\n~\n~\n~\n~\n~\n~\n~\n~\n~\n~\n~\n~\n~\n~\n~\n~\n~\n~\n~\n[Scratch] [-]                                                                                         1,0-1          All\n\n  ZEN\n"]
